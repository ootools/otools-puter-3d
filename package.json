{
  "name": "otools-puter-3d",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "3D (HeyPuter/everything) as an OTools plugin: the same editor, with documents stored as plain files on this computer instead of in a Puter cloud account.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "sync-upstream": "node scripts/sync-upstream.mjs",
    "check-upstream": "node scripts/sync-upstream.mjs --check",
    "tree": "node scripts/build.mjs --tree",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "test": "node scripts/test.mjs",
    "preview": "node scripts/serve-dist.mjs",
    "pack": "node scripts/pack-plugin.mjs",
    "verify": "node scripts/verify-plugin.mjs",
    "i18n-report": "node scripts/i18n-report.mjs",
    "release": "node scripts/build.mjs && node scripts/pack-plugin.mjs && node scripts/verify-plugin.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.2.8",
    "fzstd": "0.1.1",
    "opentype.js": "1.3.4",
    "three": "0.186.1",
    "three-bvh-csg": "0.0.18",
    "three-gpu-pathtracer": "0.0.24",
    "three-mesh-bvh": "0.9.15",
    "xatlas-web": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/opentype.js": "1.3.8",
    "@types/three": "0.186.0",
    "gltf-validator": "^2.0.0-dev.3.10",
    "happy-dom": "20.14.5",
    "typescript": "^7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "jsdom": "30.1.2"
  }
}
